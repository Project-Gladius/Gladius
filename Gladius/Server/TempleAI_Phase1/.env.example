GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_FAILURE_COOLDOWN_SECONDS=60

# Optional but strongly recommended when another computer can reach the server.
# Unreal must send the same value as X-Temple-Client-Token.
TEMPLE_CLIENT_TOKEN=replace_with_a_long_random_client_token

# Optional. Usually leave empty for Unreal native builds.
# Example for browser clients: ALLOWED_ORIGINS=https://your-game.example.com
ALLOWED_ORIGINS=
